#include <windows.h>
#ifndef VER_STR
#define VER_STR "1.0.0"
#endif
#ifndef VER_NUM
#define VER_NUM 1,0,0,0
#endif
1 ICON "mirrorly.ico"
1 RT_MANIFEST "app.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_NUM
PRODUCTVERSION VER_NUM
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Mirrorly"
      VALUE "FileDescription", "Mirrorly - AirPlay receiver for Windows"
      VALUE "FileVersion", VER_STR
      VALUE "ProductName", "Mirrorly"
      VALUE "ProductVersion", VER_STR
      VALUE "OriginalFilename", "Mirrorly.exe"
      VALUE "LegalCopyright", "GPL-3.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
